# ----------------------------------------------------------------------------
# TraceHub Inventory API - Environment Configuration
# Copy this file to .env and fill in real values before running in production.
# NEVER commit the actual .env file to git.
# ----------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# Database
# Leave DB_DIALECT=sqlite for zero-config local/dev use (creates backend/data/tracehub.sqlite)
# For production, switch to postgres and set DATABASE_URL
DB_DIALECT=sqlite
DATABASE_URL=
SQLITE_STORAGE=./data/tracehub.sqlite

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_MIN=60

# Email (SMTP) - used for verification, password reset, assignment/return reminders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TraceHub Inventory <no-reply@tracehub.app>"

# Flutterwave (payment gateway chosen for TraceHub subscriptions)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET_HASH=

# Super Admin bootstrap (used only by the seed script on first run)
SUPER_ADMIN_EMAIL=admin@tracehub.app
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Trial defaults (per original spec: 10 free assets for 1 month)
TRIAL_ASSET_LIMIT=10
TRIAL_DURATION_DAYS=30

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
